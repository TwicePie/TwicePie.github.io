---
// Hero.astro — Name, title, bio, CTA buttons. Subtle fade-in only.
import { hero, profile } from "../data/content";
import T from "./T.astro";
---
<section id="top" class="hero">
  <div class="hero-bg"></div>
  <div class="container hero-content reveal">
    <p class="hero-greeting mono"><T en={hero.greeting.en} id={hero.greeting.id} /></p>
    <h1 class="hero-name">{profile.name}</h1>
    <p class="hero-title"><T en={hero.title.en} id={hero.title.id} /></p>
    <p class="hero-bio"><T en={hero.bio.en} id={hero.bio.id} /></p>
    <div class="hero-actions">
      <a href="#contact" class="btn btn-primary"><T en={hero.ctaContact.en} id={hero.ctaContact.id} /></a>
      <a href={profile.cv} download class="btn btn-ghost"><T en={hero.ctaCV.en} id={hero.ctaCV.id} /></a>
      <a
        href={profile.gdrive}
        target="_blank"
        rel="noopener"
        class="btn btn-drive"
        aria-label="Google Drive"
      >
        <svg viewBox="0 0 87.3 78" aria-hidden="true" focusable="false">
          <path d="m6.6 66.85 3.85 6.65c.8 1.4 1.95 2.5 3.3 3.3l13.75-23.8h-27.5c0 1.55.4 3.1 1.2 4.5z" fill="#0066da"/>
          <path d="m43.65 25-13.75-23.8c-1.35.8-2.5 1.9-3.3 3.3l-25.4 44a9.06 9.06 0 0 0 -1.2 4.5h27.5z" fill="#00ac47"/>
          <path d="m73.55 76.8c1.35-.8 2.5-1.9 3.3-3.3l1.6-2.75 7.65-13.25c.8-1.4 1.2-2.95 1.2-4.5h-27.502l5.852 11.5z" fill="#ea4335"/>
          <path d="m43.65 25 13.75-23.8c-1.35-.8-2.9-1.2-4.5-1.2h-18.5c-1.6 0-3.15.45-4.5 1.2z" fill="#00832d"/>
          <path d="m61.8 53h-36.3l-13.75 23.8c1.35.8 2.9 1.2 4.5 1.2h54.8c1.6 0 3.15-.45 4.5-1.2z" fill="#2684fc"/>
          <path d="m73.4 26.5-12.7-22c-.8-1.4-1.95-2.5-3.3-3.3l-13.75 23.8 18.15 28h27.45c0-1.55-.4-3.1-1.2-4.5z" fill="#ffba00"/>
        </svg>
        <T en={hero.ctaDrive.en} id={hero.ctaDrive.id} />
      </a>
    </div>
    <div class="hero-links">
      <a href={`mailto:${profile.email}`}>Email</a>
      <span class="dim">/</span>
      <a href={profile.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      <span class="dim">/</span>
      <a href={profile.github} target="_blank" rel="noopener">GitHub</a>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
    text-align: center;
    padding: 6rem 1.5rem 4rem;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 20% 30%, rgba(255, 255, 255, 0.04), transparent 50%),
      radial-gradient(circle at 80% 70%, rgba(255, 255, 255, 0.03), transparent 50%);
    pointer-events: none;
  }
  .hero-content { position: relative; max-width: 720px; }
  .hero-greeting {
    font-size: 0.8rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-text-dim);
    margin-bottom: 1rem;
  }
  .hero-name {
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 8vw, 5rem);
    line-height: 1.1;
    margin-bottom: 0.75rem;
  }
  .hero-title {
    font-size: clamp(1rem, 3vw, 1.3rem);
    color: var(--color-text);
    margin-bottom: 1.5rem;
    font-weight: 500;
  }
  .hero-bio {
    max-width: 560px;
    margin: 0 auto 2.5rem;
    font-size: 1rem;
    line-height: 1.8;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }
  .btn {
    padding: 0.75rem 1.75rem;
    border-radius: var(--radius-sm);
    font-size: 0.9rem;
    font-weight: 500;
    transition: all var(--transition);
    border: 1px solid transparent;
  }
  .btn-primary {
    background: var(--color-accent);
    color: var(--color-bg);
  }
  .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(255, 255, 255, 0.15); }
  .btn-ghost {
    border-color: var(--color-border);
    color: var(--color-text-muted);
  }
  .btn-ghost:hover { border-color: var(--color-accent); color: var(--color-text); }
  .btn-drive {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    background: #1a73e8;
    color: #ffffff;
  }
  .btn-drive svg { width: 18px; height: 18px; flex-shrink: 0; }
  .btn-drive:hover {
    background: #1765cc;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(26, 115, 232, 0.35);
  }
  .btn-drive:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: 2px;
  }

  .hero-links {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }
  .hero-links a { transition: color var(--transition); }
  .hero-links a:hover { color: var(--color-text); }
</style>
