---
// Footer.astro
import { profile, ui } from "../data/content";
import T from "./T.astro";
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="footer-inner container">
    <div class="footer-left">
      <p class="footer-name">{profile.name}</p>
      <p class="muted mono" style="font-size:.8rem"><T en={ui.footerBuilt.en} id={ui.footerBuilt.id} /></p>
    </div>
    <div class="footer-right">
      <a href={`mailto:${profile.email}`} aria-label="Email">{profile.email}</a>
      <a href={profile.github} target="_blank" rel="noopener" aria-label="GitHub">GitHub</a>
      <a href={profile.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn">LinkedIn</a>
    </div>
  </div>
  <p class="footer-copy">© {year} {profile.name}. <T en={ui.footerRights.en} id={ui.footerRights.id} /></p>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-border);
    padding: 3rem 1.5rem 2rem;
  }
  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 2rem;
  }
  .footer-name { font-weight: 600; margin-bottom: 0.25rem; }
  .footer-right { display: flex; gap: 1.5rem; flex-wrap: wrap; }
  .footer-right a {
    color: var(--color-text-muted);
    font-size: 0.85rem;
    transition: color var(--transition);
  }
  .footer-right a:hover { color: var(--color-text); }
  .footer-copy {
    text-align: center;
    margin-top: 2.5rem;
    font-size: 0.8rem;
    color: var(--color-text-dim);
  }
</style>
