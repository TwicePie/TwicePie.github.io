---
// Certifications.astro
import { certifications, sections } from "../data/content";
import T from "./T.astro";
---
<section id="certificates" class="section section-alt">
  <div class="container">
    <span class="section-label reveal">06 — <T en={sections.certificates.en} id={sections.certificates.id} /></span>
    <h2 class="section-title reveal"><T en={sections.certificates.en} id={sections.certificates.id} /></h2>
    <div class="cert-grid reveal-stagger">
      {certifications.map((c) => (
        <article class="cert-card">
          <div class="cert-badge mono">★</div>
          <h3 class="cert-name">{c.name}</h3>
          <p class="cert-issuer">{c.issuer}</p>
          <span class="cert-date mono">{c.date}</span>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .section-alt { background: var(--color-surface); border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); }
  .cert-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1rem;
  }
  .cert-card {
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg);
    transition: border-color var(--transition), transform var(--transition);
  }
  .cert-card:hover { border-color: var(--color-text-dim); transform: translateY(-2px); }
  .cert-badge {
    font-size: 1.2rem;
    color: var(--color-accent);
    margin-bottom: 0.75rem;
  }
  .cert-name { font-size: 1rem; margin-bottom: 0.35rem; }
  .cert-issuer { color: var(--color-text-muted); font-size: 0.88rem; }
  .cert-date { font-size: 0.78rem; color: var(--color-text-dim); display: inline-block; margin-top: 0.5rem; }
</style>
